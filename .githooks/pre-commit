#!/bin/sh
''':'
# shell 部分：选择可用的 Python 解释器重新执行本脚本（兼容 Windows，无 env python3 时也可运行）
if command -v uv >/dev/null 2>&1; then
    exec uv run python "$0" "$@"
elif command -v python3 >/dev/null 2>&1; then
    exec python3 "$0" "$@"
else
    exec python "$0" "$@"
fi
':'''
# coding=utf-8

import shutil
import subprocess
import sys

CONSOLE_COLORS = {
    "RED": "\x1b[0;31m",
    "RESET": "\x1b[0m",
}

# 通过 git 获取仓库根目录（hook 经 core.hooksPath 从 .githooks/ 直接执行）
repo_root = subprocess.run(
    ["git", "rev-parse", "--show-toplevel"],
    capture_output=True,
    text=True,
    check=True,
).stdout.strip()

# 获取暂存的 .py 文件
result = subprocess.run(
    ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "--", "*.py"],
    cwd=repo_root,
    capture_output=True,
    text=True,
)
staged_files = [f for f in result.stdout.strip().split("\n") if f]

if not staged_files:
    exit(0)

print(f"Checking {len(staged_files)} staged file(s) with ruff ...")

use_uv = shutil.which("uv") is not None
ruff_cmd = ["uv", "run", "ruff"] if use_uv else [sys.executable, "-m", "ruff"]

# 只检查暂存文件
check = subprocess.call([*ruff_cmd, "check", *staged_files], cwd=repo_root)
if check != 0:
    print(CONSOLE_COLORS["RED"] + "ruff check 发现问题，请修复后再提交！")
    print(CONSOLE_COLORS["RESET"])
    exit(1)

fmt = subprocess.call([*ruff_cmd, "format", "--check", *staged_files], cwd=repo_root)
if fmt != 0:
    print(CONSOLE_COLORS["RED"] + "ruff format 检查未通过，请运行 ruff format 后再提交！")
    print(CONSOLE_COLORS["RESET"])
    exit(1)

print("ruff check + format passed")
