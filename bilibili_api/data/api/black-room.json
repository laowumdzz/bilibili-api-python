{
    "black_room": {
        "info": {
            "url": "https://api.bilibili.com/x/credit/blocked/list",
            "method": "GET",
            "verify": false,
            "params": {
                "btype": "int: 违规来源",
                "otype": "int: 违规类型",
                "pn": "int: 页码"
            },
            "comment": "获取小黑屋内容"
        },
        "detail": {
            "url": "https://api.bilibili.com/x/credit/blocked/info",
            "method": "GET",
            "verify": false,
            "params": {
                "id": "小黑屋 id"
            },
            "comment": "获取小黑屋详细信息"
        }
    },
    "jury": {
        "detail": {
            "url": "https://api.bilibili.com/x/credit/v2/jury/case/info",
            "method": "GET",
            "verify": true,
            "params": {
                "case_id": "案件仲裁 id"
            },
            "comment": "获取案件仲裁详细信息"
        },
        "opinion": {
            "url": "https://api.bilibili.com/x/credit/v2/jury/case/opinion",
            "method": "GET",
            "verify": true,
            "params": {
                "case_id": "案件仲裁 id",
                "pn":"int: 页码",
                "ps":"int: 每页数量"
            },
            "comment": "获取案件仲裁观点"
        },
        "next_case": {
            "url": "https://api.bilibili.com/x/credit/v2/jury/case/next",
            "method": "GET",
            "verify": true,
            "comment": "获取下一个案件仲裁"
        },
        "vote": {
            "url": "https://api.bilibili.com/x/credit/v2/jury/vote",
            "method": "POST",
            "verify": true,
            "params": {
                "case_id": "案件仲裁 id",
                "vote": "int: 投票结果",
                "content": "string: 投票理由",
                "insiders": "int: 是否观看此类视频",
                "anonymous": "int: 是否匿名投票",
                "csrf": "string: csrf"
            },
            "comment": "进行仲裁投票"
        },
        "case_list": {
            "url": "https://api.bilibili.com/x/credit/v2/jury/case/list",
            "method": "GET",
            "verify": true,
            "params": {
                "pn":"int: 页码",
                "ps":"int: 每页数量"
            },
            "comment": "获取案件仲裁列表"
        }
    },
  "jury_action": {
    "apply": {
      "url": "https://api.bilibili.com/x/credit/v2/jury/apply",
      "method": "POST",
      "verify": true,
      "params": {
        "csrf": "str: 必填，cookie中`bili_jct`的值"
      },
      "comment": "申请加入风纪委员会"
    },
    "apply_2": {
      "url": "https://api.bilibili.com/x/credit/jury/apply",
      "method": "POST",
      "verify": true,
      "comment": "申请加入风纪委员会"
    },
    "case_obtain": {
      "url": "https://api.bilibili.com/x/credit/jury/caseObtain",
      "method": "POST",
      "verify": true,
      "comment": "拉取新案件"
    },
    "vote": {
      "url": "https://api.bilibili.com/x/credit/jury/vote",
      "method": "POST",
      "verify": true,
      "comment": "进行仲裁投票"
    }
  },
  "jury_base_info": {
    "kpi": {
      "url": "https://api.bilibili.com/x/credit/v2/jury/kpi",
      "method": "GET",
      "verify": true,
      "params": {
        "term_id": "int: 任期 id；未传参或留空时，**只**返回最近一次已结束的任期的数据"
      },
      "comment": "统计信息"
    },
    "kpi_2": {
      "url": "https://api.bilibili.com/x/credit/jury/kpi",
      "method": "GET",
      "verify": true,
      "params": {
        "access_key": "str: 必填，APP登录Token"
      },
      "comment": "统计信息(旧API)"
    },
    "requirement": {
      "url": "https://api.bilibili.com/x/credit/v2/jury/requirement",
      "method": "GET",
      "verify": true,
      "params": {
        "access_key": "str: 必填，APP登录Token"
      },
      "comment": "检查申请风纪委员会资格"
    }
  },
  "jury_judgement_info": {
    "jury_case": {
      "url": "https://api.bilibili.com/x/credit/jury/juryCase",
      "method": "GET",
      "verify": true,
      "comment": "获取单个案件信息"
    },
    "case_info": {
      "url": "https://api.bilibili.com/x/credit/jury/caseInfo",
      "method": "GET",
      "params": {
        "cid": "int: 必填，案件id"
      },
      "comment": "查询案件众裁信息"
    },
    "case_list": {
      "url": "https://api.bilibili.com/x/credit/jury/caseList",
      "method": "GET",
      "verify": true,
      "params": {
        "access_key": "str: 必填，APP登录Token",
        "pn": "int: 页码；默认为1",
        "ps": "int: 每页显示数量；默认为30<br />最大30"
      },
      "comment": "查询案件众裁信息(旧 api)"
    },
    "opinion": {
      "url": "https://api.bilibili.com/x/credit/jury/case/opinion",
      "method": "GET",
      "comment": "获取众议观点"
    }
  }
}
