{
    "private":{
        "detail":{
            "url": "https://api.bilibili.com/x/note/info",
            "method": "GET",
            "verify": true,
            "params": {
                "oid": "oid",
                "oid_type": "oid_type",
                "note_id": "note_id"
            },
            "comment": "私有笔记详细信息"

        }
    },
    "public":{
        "detail":{
            "url": "https://api.bilibili.com/x/note/publish/info",
            "method": "GET",
            "verify": false,
            "params": {
                "cvid": "cvid"
            },
            "comment": "公开笔记详细信息"
        }
    },
    "operate": {
      "upload_img": {
        "url": "https://api.bilibili.com/x/note/image/upload",
        "method": "POST",
        "verify": true,
        "files": {
          "file": "bytes: 文件"
        }
      }
    },
  "action": {
    "add": {
      "url": "https://api.bilibili.com/x/note/add",
      "method": "POST",
      "verify": true,
      "params": {
        "oid": "int: 必填，目标id",
        "oid_type": "int: 必填，目标id类型；`0`视频(oid=avid)",
        "note_id": "int: 笔记id；创建时无需此项",
        "title": "str: 必填，笔记标题",
        "summary": "str: 必填，笔记预览文本",
        "content": "str: 必填，笔记正文json序列；格式见[附表](readme.md#附表-笔记正文序列格式)",
        "tags": "str: 笔记跳转标签列表",
        "cls": "int: 1；作用尚不明确",
        "from": "str: 提交类型；`auto`自动提交<br />`save`手动提交<br />`close`关闭时自动提交",
        "cont_len": "int: 正文字数",
        "platform": "str: 平台；可为`web`",
        "publish": "int: 是否公开笔记；`0`不公开<br />`1`公开",
        "auto_comment": "int: 是否添加到评论区；`0`不添加<br />`1`添加",
        "csrf": "str: 必填，CSRF Token（位于cookie）"
      },
      "comment": "保存视频笔记"
    },
    "del": {
      "url": "https://api.bilibili.com/x/note/del",
      "method": "POST",
      "verify": true,
      "params": {
        "oid": "int: 必填，目标稿件avid",
        "note_id": "int: 笔记id",
        "csrf": "str: 必填，CSRF Token（位于cookie）"
      },
      "comment": "删除视频笔记"
    }
  }
}