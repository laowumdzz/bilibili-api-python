{
  "b23tv": {
    "click": {
      "url": "https://api.bilibili.com/x/share/click",
      "method": "POST",
      "comment": "任意短链"
    },
    "click_2": {
      "url": "https://api.biliapi.net/x/share/click",
      "method": "POST",
      "params": {
        "buvid": "str: 必填，设备 BUVID；实际任意非空字符串即可",
        "build": "int: 必填，客户端版本号；大于 `5520400` 的任意有效整数, 如 `7710300`",
        "platform": "str: 必填，客户端平台；实际任意非空字符串即可",
        "share_channel": "str: 必填，分享方式?；COPY",
        "share_mode": "int: 必填，分享模式?；任意有效正整数, 常见 `1`, `3`, `4`",
        "share_id": "str: 必填，分享 ID；见下方对照表",
        "share_origin": "str: 必填，分享来源?；见下方对照表",
        "oid": "int: 必填，对象 ID；见下方对照表",
        "object_extra_fields": "dict: 额外字段?；如 `{\"jumpfrom_id\":30104}` `{\"epid\":\"409808\",\"cid\":\"1398781253\"}` `{\"season_type\":\"1\",\"season_id\":\"39481\",\"epid\":\"425006\",\"dubbing_support\":false,\"background_audio\":false,\"role_audio_list\":false}`",
        "panel_type": "int: 面板类型?；1",
        "share_title": "str: 分享标题?；分享标题",
        "share_content": "str: 分享内容?；分享内容, 当 oid 存在时无意义<s>(可是 oid 不可能不存在啊)</s>",
        "share_pattern": "int: 分享模式?；0",
        "share_session_id": "str: 分享会话 ID?；各部分用 `-` 分隔的小写的一串 UUID",
        "ts": "int: UNIX 秒级时间戳",
        "code": "int: 0；恒为 0",
        "message": "str: 0；恒为 0",
        "ttl": "int: 1；恒为 1",
        "data": "dict: 信息本体",
        "content": "str: 短链内容；若失败则不存在",
        "count": "int: 0；恒为 0"
      },
      "comment": "任意短链"
    }
  },
  "buvid3_4": {
    "getbuvid": {
      "url": "https://api.bilibili.com/x/web-frontend/getbuvid",
      "method": "GET",
      "comment": "仅获取 buvid3"
    }
  },
  "mathjax": {
    "tex": {
      "url": "https://api.bilibili.com/x/web-frontend/mathjax/tex",
      "method": "GET",
      "params": {
        "formula": "str: 公式；LaTeX"
      },
      "comment": "LaTeX"
    }
  },
  "sign_v_voucher": {
    "register": {
      "url": "https://api.bilibili.com/x/gaia-vgate/v1/register",
      "method": "POST",
      "params": {
        "csrf": "str: CSRF Token (位于 Cookie 的 bili_jct)",
        "v_voucher": "str: 必填，v_voucher"
      },
      "comment": "从 v_voucher 申请 captcha"
    },
    "validate": {
      "url": "https://api.bilibili.com/x/gaia-vgate/v1/validate",
      "method": "POST",
      "params": {
        "csrf": "str: CSRF Token (位于 Cookie 的 bili_jct)；若登陆则必要",
        "challenge": "str: 必填，验证码 challenge",
        "token": "str: 必填，验证码 token",
        "validate": "str: 必填，验证结果 validate",
        "seccode": "str: 必填，验证结果 seccode"
      },
      "comment": "从验证结果获取 grisk_id"
    }
  },
  "time_stamp": {
    "now": {
      "url": "https://api.bilibili.com/x/report/click/now",
      "method": "GET",
      "comment": "获取当前时间戳"
    },
    "now_2": {
      "url": "https://api.bilibili.com/x/click-interface/click/now",
      "method": "GET",
      "comment": "获取当前时间戳"
    },
    "get_timestamp": {
      "url": "https://api.live.bilibili.com/xlive/open-interface/v1/rtc/getTimestamp",
      "method": "GET",
      "comment": "获取适用于 RTC 的时间戳"
    },
    "serverdate_js": {
      "url": "https://interface.bilibili.com/serverdate.js",
      "method": "GET",
      "comment": "获取服务器端UTC时间"
    }
  }
}
