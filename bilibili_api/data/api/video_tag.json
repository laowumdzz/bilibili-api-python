{
  "info": {
    "tag_info": {
      "url": "https://api.bilibili.com/x/tag/info",
      "method": "GET",
      "params": {
        "tag_name": "str: 标签名",
        "tag_id": "int: 标签 id",
        "#": "上面两个参数任选一个即可"
      },
      "comment": "获取标签详情"
    },
    "get_similar": {
      "url": "https://api.bilibili.com/x/tag/change/similar",
      "method": "GET",
      "params": {
        "tag_id": "int: 标签 id"
      },
      "comment": "获取相关的标签"
    },
    "get_list": {
      "url": "https://api.vc.bilibili.com/topic_svr/v1/topic_svr/topic_new",
      "method": "GET",
      "params": {
        "topic_id": "int: 标签 id"
      },
      "comment": "获取相关的动态/视频"
    },
    "get_history_list": {
      "url": "https://api.vc.bilibili.com/topic_svr/v1/topic_svr/topic_history",
      "method": "GET",
      "params": {
        "topic_id": "int: 标签 id",
        "offset_dynamic_id": "int: 起始视频/动态的dynamic_id(不包含自身)"
      },
      "comment": "获取从指定dynamic_id视频的后一位开始的相关的动态/视频, 先用get_list获取dynamic_id。"
    }
  },
  "tags": {
    "tags": {
      "url": "https://api.bilibili.com/x/tag/archive/tags",
      "method": "GET",
      "verify": true,
      "params": {
        "aid": "int: 必填，稿件avid；avid与bvid任选一个",
        "bvid": "str: 必填，稿件bvid；avid与bvid任选一个"
      },
      "comment": "获取视频TAG信息（旧）"
    },
    "like2": {
      "url": "https://api.bilibili.com/x/tag/archive/like2",
      "method": "POST",
      "verify": true,
      "params": {
        "aid": "int: 必填，稿件avid",
        "tag_id": "int: 必填，tag_id",
        "csrf": "str: 必填，CSRF Token（位于cookie）"
      },
      "comment": "点赞&取消点赞视频TAG"
    },
    "hate2": {
      "url": "https://api.bilibili.com/x/tag/archive/hate2",
      "method": "POST",
      "verify": true,
      "params": {
        "aid": "int: 必填，稿件avid",
        "tag_id": "int: 必填，tag_id",
        "csrf": "str: 必填，CSRF Token（位于cookie）"
      },
      "comment": "点踩&取消点踩视频TAG"
    }
  }
}
